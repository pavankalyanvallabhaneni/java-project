# ========================================================
# BharatHire - Environment Configuration Example
# Copy this file to .env and configure for your environment
# ========================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
# In dev profile, H2 in-memory mode is available as fallback if MySQL is not running.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bharathire_db
DB_USER=root
DB_PASSWORD=root_password

# JWT Security
# Must be at least 256 bits (32 bytes) secret key for HMAC-SHA256
JWT_SECRET=bharathire_super_secret_jwt_key_2026_indian_recruitment_portal_security_key_xyz987
JWT_EXPIRATION_MS=86400000

# File Upload Configuration
UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE=5MB

# Client / Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Mail Configuration (optional for local dev; dev mode logs reset tokens to console/response)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@bharathire.in
MAIL_PASSWORD=your_app_password
